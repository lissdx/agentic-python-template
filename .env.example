# Copy to .env and fill in. Never commit .env — see .gitignore.
#
# This file is the documented surface of the process environment: every variable
# the code reads appears here with a comment and without a value. A variable that
# is not listed here is a variable nobody can find.

# The provider seam reads these and nothing else does.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Application log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Uncomment together with the db service in devenv/docker/compose.yaml.
# DATABASE_URL=
# POSTGRES_USER=app
# POSTGRES_PASSWORD=app
# POSTGRES_DB=app
# POSTGRES_PORT=55432

# Observability. Leave empty to disable tracing.
TRACE_ENDPOINT=
