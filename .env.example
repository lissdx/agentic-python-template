# Copy to .env and fill in. Never commit .env — see .gitignore.
#
# This file is the documented surface of the process environment: every variable
# the code reads appears here with a comment and without a value. A variable that
# is not listed here is a variable nobody can find.
#
# Compose also reads .env for the substitutions in compose.yaml, so the database
# settings below are shared by the application and by the local stack.

# The provider seam reads these and nothing else does.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Local Postgres, defined in compose.yaml. Defaults are baked into that file, so
# these only need setting when you want something else.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# Host port for the database. Not 5432: that one is usually already taken.
POSTGRES_PORT=55432

# Observability. Leave empty to disable tracing.
TRACE_ENDPOINT=

# Application log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
