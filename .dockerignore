# The build context is everything in this file's directory. Without these lines
# a local .venv and the whole .git history are uploaded to the daemon on every
# build — slow, and a way for secrets to reach an image layer.

.git
.github
.venv
venv
**/__pycache__
*.py[cod]
.mypy_cache
.pytest_cache
.ruff_cache
htmlcov
.coverage
dist
build
*.egg-info

# Secrets and local state.
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json
*token*.json

# Nothing here runs in the image.
docs
examples
notebooks
tests
db
deploy
scripts
compose*.yaml
*.md
!README.md
