# ── OS ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editors / IDE ─────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Logs ──────────────────────────────────────────────────────────────
*.log

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.Python
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# ── Secrets and environment ───────────────────────────────────────────
# Never commit these. .env.example is the documented surface; .env is the
# filled-in one and belongs only on the machine that filled it.
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json
*token*.json
client_secret*.json

# ── Data ──────────────────────────────────────────────────────────────
# Real inputs are never source. An eval set built from production data carries
# whatever that data carried; keep it out of history, where deletion does not
# reach.
data/
eval_data/

# ── Agent toolchains ──────────────────────────────────────────────────
# Vendored catalogues installed by a coding-agent toolchain (BMAD and the like)
# are someone else's distribution, not project source. Closed before the first
# install, because a public repository is not the place to discover this.
_bmad/
_bmad-output/
.claude/
CLAUDE.local.md

# ── Generated ─────────────────────────────────────────────────────────
# Reproducible from source by `make`; see AGENTS.md.
generated/

# ── Scratch ───────────────────────────────────────────────────────────
tmp/
scratch/
*.bak
